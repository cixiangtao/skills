# Keep every local agent asset private unless it is explicitly allowlisted below.
/*

# Repository files
!/.gitignore
!/.oxfmtrc.json
!/.oxlintrc.json
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/SUPPORT.md
!/package.json
!/pnpm-lock.yaml
!/scripts/
!/.github/
/.github/*
!/.github/README.md
!/.github/dependabot.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/feature.yml
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml

# Enter the skill collection, but keep installed skills private by default.
!/skills/
/skills/*

# Public skills
!/skills/commit-granularity/
!/skills/github-open-source-lifecycle/
